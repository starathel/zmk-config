#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            bindings = <
&kp ESC           &kp N1  &kp N2  &kp N3    &kp N4    &kp N5                         &kp N6  &kp N7         &kp N8     &kp N9   &kp N0    &kp UNDERSCORE
&kp TAB           &kp Q   &kp W   &kp E     &kp R     &kp T                          &kp Y   &kp U          &kp I      &kp O    &kp P     &kp BACKSLASH
&kp LEFT_SHIFT    &kp A   &kp S   &kp D     &kp F     &kp G                          &kp H   &kp J          &kp K      &kp L    &kp SEMI  &kp SQT
&kp LEFT_CONTROL  &kp Z   &kp X   &kp C     &kp V     &kp B   &kp LBKT     &kp RBKT  &kp N   &kp M          &kp COMMA  &kp DOT  &kp FSLH  &kp BACKSPACE
                                  &kp LALT  &kp LGUI  &mo 1   &kp SPACE    &kp RET   &mo 2   &kp BACKSPACE  &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            // --------------------------------------------------------------------------------------------------------------
            // | LPAD  | BRDn | BRUp |  MUT |  Vo- |  Vo+ |                   |      |       |       |      |       |       |
            // |  F1   |  F2  |  F3  |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !   |  @   |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |      |      |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                       |      |      |      |        |  |       |      |       |       |

            bindings = <
&trans         &trans       &trans       &trans           &trans         &trans                                                  &trans                 &trans          &trans  &trans  &trans        &trans
&kp TILDE      &kp DOLLAR   &kp PAGE_UP  &kp UP           &kp PAGE_DOWN  &kp LEFT_PARENTHESIS                                    &kp RIGHT_PARENTHESIS  &kp N7          &kp N8  &kp N9  &kp KP_PLUS   &kp GRAVE
&kp AMPERSAND  &kp PERCENT  &kp LEFT     &kp DOWN         &kp RIGHT      &kp LEFT_BRACKET                                        &kp RIGHT_BRACKET      &kp N4          &kp N5  &kp N6  &kp KP_MINUS  &kp KP_MULTIPLY
&trans         &kp CARET    &kp HOME     &kp PRINTSCREEN  &kp END        &kp LEFT_BRACE        &kp KP_MULTIPLY    &kp AMPERSAND  &kp RIGHT_BRACE        &kp N1          &kp N2  &kp N3  &kp KP_EQUAL  &trans
                                         &trans           &trans         &trans                &kp SPACE          &kp ENTER      &trans                 &kp LEFT_SHIFT  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            bindings = <
&trans  &trans       &trans      &trans           &trans                &trans                          &trans  &trans                 &trans       &trans     &trans         &trans
&trans  &kp PIPE     &kp DOLLAR  &kp EXCLAMATION  &kp LEFT_PARENTHESIS  &trans                          &trans  &kp RIGHT_PARENTHESIS  &kp AT_SIGN  &kp POUND  &kp BACKSLASH  &trans
&trans  &kp MINUS    &kp CARET   &kp AMPERSAND    &kp LEFT_BRACKET      &trans                          &trans  &kp RIGHT_BRACKET      &kp PERCENT  &kp ASTRK  &kp UNDER      &trans
&trans  &kp KP_PLUS  &kp GRAVE   &kp TILDE        &kp LEFT_BRACE        &trans  &trans       &trans     &trans  &kp RIGHT_BRACE        &trans       &trans     &kp KP_EQUAL   &trans
                                 &trans           &trans                &trans  &kp SPACE    &kp ENTER  &trans  &trans                 &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_3 {
            bindings = <
&studio_unlock  &studio_unlock  &trans      &trans                &trans                &trans                    &bt BT_CLR  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_SEL 0
&trans          &trans          &trans      &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &trans                    &kp F10     &kp F1        &kp F2        &kp F3        &trans        &trans
&trans          &trans          &kp K_MUTE  &kp C_VOLUME_DOWN     &kp C_VOLUME_UP       &trans                    &kp F11     &kp F4        &kp F5        &kp F6        &trans        &trans
&trans          &trans          &trans      &trans                &trans                &trans  &trans    &trans  &kp F12     &kp F7        &kp F8        &kp F9        &trans        &trans
                                            &kp LEFT_ALT          &kp LEFT_WIN          &trans  &trans    &trans  &trans      &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        aaa {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
